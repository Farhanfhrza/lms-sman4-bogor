            <!-- Simple No Results logic for alpine search -->
             <div class="hidden" :class="{ 'block': true, 'hidden': false }" 
                  x-show="false" 
                  x-effect="
                    let visibleCount = 0;
                    $el.previousElementSibling.querySelectorAll('[x-show]').forEach(el => {
                         if(el.style.display !== 'none') visibleCount++;
                    });
